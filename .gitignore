fixtures/*
# Keep the data-free, permanent validation tests tracked (they generate from committed
# source, need no private CSV). The CSV exports + data-driven throwaway scripts stay ignored.
!fixtures/brew-roundtrip-test.js
!fixtures/wrapped-cards-test.js
!fixtures/insights-room-test.js
!fixtures/greeting-v4-test.js
!fixtures/status-line-test.js
!fixtures/steeping-timer-test.js
!fixtures/flavor-ladder-test.js
!fixtures/tea-search-test.js
!fixtures/stat-period-test.js
!fixtures/log-guard-test.js
!fixtures/shelf-order-test.js
!fixtures/tea-types-test.js
!fixtures/brew-feedback-test.js
!fixtures/flavor-tree-test.js
# The export gate is the exception to "data-free": it asserts the CSV set itself is current and
# single-vintage. It reads the exports rather than generating from source, but it must be tracked —
# a gate that only exists on one machine is not a gate. Run it before every other suite.
!fixtures/export-gate-test.js
# The figures reporter (R67): §1's snapshot block is GENERATED from fixtures/, never hand-copied.
# Tracked for the same reason as the gate — a generator that lives on one machine can't be the
# source of truth for a document everyone reads.
!fixtures/figures-report.js
# R3 slice A: the vessel identity ladder is invisible on current data (every vessel has a photo), so
# this suite is the only thing that can see rungs 2 and 3. It also pins the R64/R72 lane contracts.
!fixtures/vessel-identity-test.js
# R3 slice B: the one guard that Go Deeper NEVER WRITES. A read-only contract has no runtime symptom
# when it breaks — the surface would just quietly start saving — so this suite must exist everywhere,
# not on one machine. `git add -A` skips an ignored file SILENTLY, which is how it shipped untracked
# the first time while both the CHANGELOG and its own header called it committed.
!fixtures/reference-test.js
# Local Claude Code state (launch.json, settings.local.json, etc.) stays ignored, but
# committed project skills under .claude/skills/ and subagent definitions under
# .claude/agents/ are tracked so they ship with the repo.
.claude/*
!.claude/skills/
!.claude/agents/
# Design WORKING files stay local: raw inspiration, teaware source shots, and loose
# .dc.html exports. The LOCKED R3 record lives in docs/r3/boards/ and IS committed —
# it's the spec Code builds from, not reference. The old "~10MB each of inlined runtime"
# premise died with the final export: it factors the runtime into one shared support.js
# (68 KB), so all 21 boards together are ~660 KB. Scoped to that folder — a stray
# .dc.html anywhere else is still a working file and stays ignored.
SlowCup R2 bundle handoff/
design-r3/
*.dc.html
!docs/r3/boards/*.dc.html
# Photographs of copyrighted tea-book pages, kept for transcription only. The repo is
# PUBLIC — the images must never be committed. The factual data transcribed from them
# (aroma taxonomy, tasting lexicon) lives in docs/r3/planning/DATA-*.md and IS committed.
book_reference_material/
